    alias: TranQuangDat2005
repository-code: "https://github.com/TranQuangDat2005/datkit-for-coding"
license: MIT
version: "1.0.1"
date-released: "2026-08-21"
keywords:
  - spec-driven development
  - ai coding agents
  - software engineering
  - cli
  - copilot
  - specification
related-identifiers:
